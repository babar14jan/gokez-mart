{
  "name": "mart-user",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "tsc && vite build && node scripts/write-version.mjs && node scripts/prerender-public-pages.mjs && node scripts/seo-check.mjs",
    "cap:build": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "apk:debug": "npm run cap:build && cd android && ./gradlew assembleDebug",
    "seo:check": "node scripts/seo-check.mjs",
    "gen:ios-splash": "node scripts/gen-ios-splash.mjs",
    "gen:native-splash": "node scripts/gen-native-splash.mjs",
    "gen:app-icons": "node scripts/gen-app-icons.mjs",
    "gen:brand-assets": "node scripts/gen-brand-assets.mjs",
    "preview": "vite preview --port 5177",
    "seo:check:full": "node --import tsx scripts/seo-check.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "axios": "^1.6.2",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "^4.0.0",
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  }
}
