/sw.js
  Content-Type: application/javascript
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# The HTML entry carries the theme-color, the preload hints, and the asset URLs
# for the current build, so it must never be pinned at the edge or in a browser.
# Pages already serves HTML as "public, max-age=0, must-revalidate" (verified
# live), so this is belt-and-braces for proxies that treat max-age=0 as reusable.
#
# Scoped to the entry only. Cloudflare *joins* duplicate Cache-Control values
# with commas when several rules match, so a "/*" rule here would be appended to
# the /assets/* immutable rule and poison the content-hashed asset cache.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# The update check must always see the deploy the edge is actually serving.
# Each build rewrites these with a fresh id; a cached copy would hide the update
# from useAppUpdate and from the service worker's install/activate handlers.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/cache-version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Runtime deploy switch, read by useAppUpdate on every poll. "silent" (default)
# keeps the non-disruptive behavior; "force" makes open tabs and installed PWAs
# reload themselves to a new build without the customer closing them. Must never
# be cached, or a flipped mode would be invisible for the cache's lifetime.
/update-policy.json
  Content-Type: application/json
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons and PWA icons are deliberately NOT immutable.
#
# /assets/* is safe to mark immutable because Vite content-hashes those files, so
# a changed file always gets a new URL. The icons below are copied verbatim out
# of public/ under stable paths, so an immutable policy would pin the old artwork
# in browsers and at the Cloudflare edge indefinitely and the new favicon could
# never reach returning visitors. One day balances that against PWA install cost.
#
# favicon.ico also gets an explicit Content-Type so it can never be served as
# text/html by the SPA fallback.
#
# This is targeted: the immutable /assets/* rule above is left untouched.
/favicon.ico
  Content-Type: image/x-icon
  Cache-Control: public, max-age=86400

/favicon-16.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/favicon-32.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/icons/*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# iOS launch images referenced from index.html. Stable public/ paths like the
# icons above, so the same one-day policy applies: long enough that a reinstall
# reuses them from cache, short enough that new artwork still lands.
/splash/*
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# The bottom nav's centre "Vegetables" icon. It is the only image the app shell
# paints, lives in public/ under a stable (unhashed) path, and is deliberately
# preloaded from index.html, so it must have a deterministic cache policy: without
# one the browser and the Cloudflare edge fall back to heuristics and re-validate
# on a cold visit. One day mirrors the favicon rule above — long enough that a
# return visit paints it from cache, short enough that new artwork still lands.
/fresh-veg.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=86400

# "Add to home screen" guide screenshots, opened from the Account page. Stable
# public/ paths like the icon above, so they get the same one-day policy. Only
# fetched on a phone that has not installed the app (see utils/install.ts).
/iphone.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=86400

/android.webp
  Content-Type: image/webp
  Cache-Control: public, max-age=86400
