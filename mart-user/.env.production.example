# Set this exact variable in Cloudflare Pages before building the customer app.
# Use the API's public address, including the API prefix.
# Example: https://api.mart.gokez.com/api/v1
VITE_API_URL=https://your-api-host/api/v1

# Native Android only. Relative paths are appended to VITE_API_URL.
# Backend contract: POST {token, platform: 'android'} with the customer's Bearer token.
# Leave unset until the backend FCM token endpoints exist.
VITE_FCM_TOKEN_ENDPOINT=/push/register-fcm
VITE_FCM_TOKEN_UNREGISTER_ENDPOINT=/push/unregister-fcm