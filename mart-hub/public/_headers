/sw.js
  Content-Type: application/javascript
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate

# The update check must always see the deploy the edge is actually serving.
# Each build rewrites these with a fresh id; a cached copy would hide the update
# from useAppUpdate and from the service worker's install/activate handlers.
/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/cache-version.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# iOS launch images referenced from index.html. Stable public/ paths, deliberately
# NOT immutable, so updated artwork still reaches a reinstalled PWA.
/splash/*
  Content-Type: image/png
  Cache-Control: public, max-age=86400