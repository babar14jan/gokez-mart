# Production environment for the Gokez Mart API on Hostinger.
# Copy to /opt/gokez-mart-backend/.env on the VPS and fill in real values.
# Never commit the filled-in file.

NODE_ENV=production
PORT=3000

# Existing Supabase PostgreSQL database. Do not change.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL is not a separate variable in this codebase: production sets SSL automatically.

# Auth and CORS
MART_JWT_SECRET=replace_with_a_unique_secret_of_at_least_32_characters
MART_JWT_EXPIRES_IN=90d
MART_CORS_ORIGIN=https://mart.gokez.com,https://hub.gokez.com
# Public API base including /api/v1; used for promotion click-tracking URLs.
MART_PUBLIC_API_URL=https://api.mart.gokez.com/api/v1
MART_CUSTOMER_APP_URL=https://mart.gokez.com
MART_STORAGE_PUBLIC_BASE_URL=

# Image storage
IMAGE_STORAGE_DRIVER=hostinger
HOSTINGER_STORAGE_URL=http://gokez-storage:8080
HOSTINGER_STORAGE_API_KEY=replace_with_the_same_key_used_by_storage-service
HOSTINGER_STORAGE_PROJECT_ID=gokez-mart

# Legacy Supabase storage, retained for existing URLs and rollback
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# SMS OTP
TWO_FACTOR_API_KEY=replace_me

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gokez.com

# Monitoring
SENTRY_DSN=

# Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GokezMart/1.0 (support@gokez.com)

# Disable recurring jobs on Hostinger while Render is still running.
MART_BACKGROUND_JOBS_ENABLED=false
