# Server
PORT=3004
NODE_ENV=development

# Local database only. Start it with: docker compose -f docker-compose.local.yml up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gokez_mart_dev

# Supabase Storage (same project, separate bucket)
SUPABASE_URL=https://your-project-ref.supabase.co
MART_STORAGE_PUBLIC_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/mart-products
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT
MART_JWT_SECRET=change_this_in_production
MART_JWT_EXPIRES_IN=90d

# CORS
MART_CORS_ORIGIN=http://localhost:5177,http://localhost:5178

# Default admin (change after first login)
MART_ADMIN_USERNAME=mart_admin
MART_ADMIN_PASSWORD=change_this_immediately

# Image storage driver: 'supabase' (default) or 'hostinger'
IMAGE_STORAGE_DRIVER=hostinger
# Hostinger storage service (required only when IMAGE_STORAGE_DRIVER=hostinger)
HOSTINGER_STORAGE_URL=https://images.gokez.com
HOSTINGER_STORAGE_API_KEY=your_storage_api_key
HOSTINGER_STORAGE_PROJECT_ID=gokez-mart
